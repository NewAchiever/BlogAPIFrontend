{
  "rewrites": [
     {
      "source": "/auth/:path*",
      "destination": "https://privateblogapibackend-production.up.railway.app/auth/:path*"
    },
    {
      "source": "/post/:path*",
      "destination": "https://privateblogapibackend-production.up.railway.app/post/:path*"
    },
    {
      "source": "/comment/:path*",
      "destination": "https://privateblogapibackend-production.up.railway.app/comment/:path*"
    },
    {
      "source": "/user/:path*",
      "destination": "https://privateblogapibackend-production.up.railway.app/user/:path*"
    },
    {
      "source": "/profile_pic/:path*",
      "destination": "https://privateblogapibackend-production.up.railway.app/profile_pic/:path*"
    },
    {
      "source": "/cover_image/:path*",
      "destination": "https://privateblogapibackend-production.up.railway.app/cover_image/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}